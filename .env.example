# BLS account credentials (REQUIRED)
EMAIL=your_email@example.com
PASSWORD=your_password

# Telegram notifications (OPTIONAL, but this is how you hear about a slot)
# Create a bot:      https://t.me/BotFather
# Find your chat ID: https://t.me/userinfobot
# Or just run: npm run telegram-setup
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321

# City selection (OPTIONAL - overrides the defaults in config.js)
# MULTI_CITY=1 searches every entry in CITIES; 0 searches one.
# ACTIVE_CITY names that one city, and MUST already be set on your
# portal profile - single-city mode never edits it.
# MULTI_CITY=0
# ACTIVE_CITY=Islamabad
